
<#
.SYNOPSIS
    Aggregates remediation logs and generates a summary report.

.DESCRIPTION
    Reads logs from C:\ProgramData\Remediation\Logs and outputs a summary
    of recent remediation activity for monitoring.

.PARAMETER LogPath
    Path to remediation logs. Default: C:\ProgramData\Remediation\Logs

.PARAMETER Days
    Number of days of logs to include. Default: 7
#>

[CmdletBinding()]
param(
    [string]$LogPath = "$env:ProgramData\Remediation\Logs",
    [int]$Days = 7
)

if (-not (Test-Path $LogPath)) {
    Write-Host "No remediation logs found at $LogPath" -ForegroundColor Yellow
    exit 0
}

$cutoff = (Get-Date).AddDays(-$Days)
$files = Get-ChildItem -Path $LogPath -Filter "Remediation-*.log" -ErrorAction SilentlyContinue |
    Where-Object { $_.LastWriteTime -ge $cutoff } |
    Sort-Object LastWriteTime -Descending

if ($files.Count -eq 0) {
    Write-Host "No log files in the last $Days days." -ForegroundColor Yellow
    exit 0
}

Write-Host "`n=== Remediation Log Report (last $Days days) ===" -ForegroundColor Cyan
Write-Host "Log path: $LogPath`n" -ForegroundColor Gray

$totalLines = 0
$successCount = 0
$errorCount = 0

foreach ($file in $files) {
    $content = Get-Content $file.FullName -ErrorAction SilentlyContinue
    if ($content) {
        $totalLines += $content.Count
        $successCount += ($content | Select-String "SUCCESS").Count
        $errorCount += ($content | Select-String "ERROR").Count
    }
}

Write-Host "Log files: $($files.Count)"
Write-Host "Total log entries: $totalLines"
Write-Host "Success events: $successCount" -ForegroundColor Green
Write-Host "Error events: $errorCount" -ForegroundColor $(if ($errorCount -gt 0) { "Red" } else { "Green" })

Write-Host "`n--- Recent activity (last 20 entries) ---" -ForegroundColor Cyan
$allContent = $files | ForEach-Object { Get-Content $_.FullName -ErrorAction SilentlyContinue } | Select-Object -Last 20
$allContent | ForEach-Object { Write-Host $_ }

Write-Host "`nReport complete." -ForegroundColor Gray


